        {
            return m_QueueRef.size();
        }
            size_t
        unused() const
        {
            return m_QueueRef.unused();
        }
    constexpr  uint64_t
Cstr2uint64(const char* cs, size_t len)
    noexcept
{
    if ( !len ) return 0ull;
    ASSERT(!cs[len]);

        constexpr uint64_t
    CHAR_FACTOR=97
    ;
        uint64_t
    value_feedback_divider= 190172619316593311ull; // max_prime_below((2^64)/CHAR_FACTOR)
    ;
        uint64_t
    out=len
    ;

 #define FIRST_CHARS_DONE ( ((out*=CHAR_FACTOR)+=MostFrequntUsedEncode(*cs++)), *cs)
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
      if FIRST_CHARS_DONE return out;
 #undef FIRST_CHARS_DONE

    do {
        uint64_t cycled= out/ value_feedback_divider; // saving upper bits by rotating, before the get lost in next multiplication.
        ( ( out*= CHAR_FACTOR )+= cycled )+= MostFrequntUsedEncode( *cs++ );
    } while (!*cs);
    return out;
}
