#define IMPLEMENT_SHIFTLEFT_FOR(_CONTAINER_TYPE) template<typename OS_T,typename... T> \
OS_T& operator << (OS_T& os_,_CONTAINER_TYPE<T...>const& _container){return _operator_shiftleft_body(os_,_container);}
