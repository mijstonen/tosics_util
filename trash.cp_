    template<
        typename _LambdaT
    >
    struct
Finally
{
    _LambdaT m_lambda;
    explicit Finally(_LambdaT _lambda)
    : m_lambda(_lambda)
    {
    }
    ~Finally()
    {
        m_lambda();
    }
};
